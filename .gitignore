# === Root-level ignores ===
node_modules/
package-lock.json
.env

# === Frontend ignores ===
frontend/node_modules/
frontend/build/
frontend/.next/
frontend/.env
# Optional lock file ignore
# frontend/package-lock.json
# frontend/yarn.lock

# === Backend ignores ===
backend/node_modules/
backend/dist/
backend/.env
# Optional lock file ignore
# backend/package-lock.json
# backend/yarn.lock

# === Log files ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === OS/system files ===
.DS_Store
Thumbs.db

# === IDE/editor settings ===
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
